function(package_run output)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE stdout
        ERROR_VARIABLE stderr OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Command failed (${result}): ${ARGN}\n${stdout}\n${stderr}")
    endif()
    set(${output} "${stdout}" PARENT_SCOPE)
endfunction()

function(package_json_quote output value)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(package_check_architecture path)
    file(SIZE "${path}" size)
    file(READ "${path}" header LIMIT 64 HEX)
    if(TOTP_PLATFORM STREQUAL "windows")
        if(size LESS 64 OR NOT header MATCHES "^4d5a")
            message(FATAL_ERROR "Invalid PE binary: ${path}")
        endif()
        # e_lfanew is a little-endian 32-bit offset in the DOS header.
        set(offset 0)
        foreach(index RANGE 0 3)
            math(EXPR position "120 + ${index} * 2")
            string(SUBSTRING "${header}" ${position} 2 byte)
            math(EXPR offset "${offset} + (0x${byte} << (${index} * 8))")
        endforeach()
        math(EXPR end "${offset} + 26")
        if(end GREATER size)
            message(FATAL_ERROR "Truncated PE header: ${path}")
        endif()
        file(READ "${path}" pe OFFSET ${offset} LIMIT 26 HEX)
        string(SUBSTRING "${pe}" 48 4 magic)
        if(NOT pe MATCHES "^504500004c01" OR NOT magic STREQUAL "0b01")
            message(FATAL_ERROR "Expected PE32/i386: ${path}")
        endif()
    else()
        if(size LESS 52 OR NOT header MATCHES "^7f454c460101")
            message(FATAL_ERROR "Expected little-endian ELF32: ${path}")
        endif()
        string(SUBSTRING "${header}" 32 8 type_machine)
        if(NOT type_machine STREQUAL "03000300")
            message(FATAL_ERROR "Expected ELF32/i386 shared object: ${path}")
        endif()
    endif()
endfunction()

function(package_windows_runtime plugin output)
    find_program(dumpbin NAMES dumpbin REQUIRED)
    package_run(exports "${dumpbin}" /exports "${plugin}")
    string(REPLACE "\n" ";" lines "${exports}")
    set(names "")
    foreach(line IN LISTS lines)
        if(line MATCHES "^[ \t]+[0-9]+[ \t]+[0-9A-Fa-f]+[ \t]+[0-9A-Fa-f]+[ \t]+([A-Za-z_][A-Za-z0-9_]*)")
            list(APPEND names "${CMAKE_MATCH_1}")
        endif()
    endforeach()
    list(SORT names)
    set(expected "AmxLoad;AmxUnload;ComponentEntryPoint;Load;Supports;Unload")
    if(NOT names STREQUAL expected)
        message(FATAL_ERROR "Unexpected plugin exports: ${names}")
    endif()

    set(queue "${plugin}")
    set(visited "")
    set(runtime "{}")
    while(queue)
        list(POP_FRONT queue binary)
        get_filename_component(filename "${binary}" NAME)
        string(TOLOWER "${filename}" key)
        if(key IN_LIST visited)
            continue()
        endif()
        list(APPEND visited "${key}")
        package_check_architecture("${binary}")
        package_run(imports "${dumpbin}" /dependents "${binary}")
        string(REPLACE "\n" ";" lines "${imports}")
        set(dependencies "[]")
        set(count 0)
        foreach(line IN LISTS lines)
            string(STRIP "${line}" name)
            if(NOT name MATCHES "^[A-Za-z0-9_.-]+\\.[dD][lL][lL]$")
                continue()
            endif()
            package_json_quote(quoted "${name}")
            string(JSON dependencies SET "${dependencies}" ${count} "${quoted}")
            math(EXPR count "${count} + 1")
            string(TOLOWER "${name}" lower)
            if(EXISTS "${TOTP_STAGE_DIR}/${name}")
                list(APPEND queue "${TOTP_STAGE_DIR}/${name}")
            elseif(lower MATCHES "^(vcruntime|msvcp|concrt|vccorlib).*[.]dll$")
                set(source "${TOTP_MSVC_RUNTIME_DIR}/${name}")
                if(NOT EXISTS "${source}")
                    message(FATAL_ERROR "Missing x86 redistributable CRT: ${source}")
                endif()
                package_check_architecture("${source}")
                # Validate the external x86 CRT; servers install the VC Redistributable.
                list(APPEND queue "${source}")
            elseif(lower MATCHES "^(api-ms-win-|ext-ms-win-)")
                # API sets and the UCRT are supplied by supported Windows versions.
                continue()
            elseif(NOT EXISTS "$ENV{WINDIR}/SysWOW64/${name}" AND
                   NOT EXISTS "$ENV{WINDIR}/System32/${name}")
                message(FATAL_ERROR "Unresolved non-system DLL: ${name}")
            endif()
        endforeach()
        if(count EQUAL 0)
            message(FATAL_ERROR "Could not inspect PE dependencies: ${binary}")
        endif()
        string(JSON runtime SET "${runtime}" "${filename}" "${dependencies}")
    endwhile()
    set(${output} "${runtime}" PARENT_SCOPE)
endfunction()

function(package_check_ldd binary expected_crypto output)
    package_run(resolved ldd "${binary}")
    if(resolved MATCHES "not found" OR NOT resolved MATCHES "libcrypto[.]so[.]3[ \t]+=>[ \t]+([^ \t\r\n]+)")
        message(FATAL_ERROR "Missing Linux dependency: ${binary}\n${resolved}")
    endif()
    file(REAL_PATH "${CMAKE_MATCH_1}" actual)
    file(REAL_PATH "${expected_crypto}" expected)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Wrong libcrypto for ${binary}: ${actual}; expected ${expected}")
    endif()
    set(${output} "${resolved}" PARENT_SCOPE)
endfunction()

function(package_linux_runtime plugin crypto output glibc_output)
    if(NOT "$ENV{LD_LIBRARY_PATH}" STREQUAL "" OR NOT "$ENV{LD_PRELOAD}" STREQUAL "")
        message(FATAL_ERROR "Run packaging without LD_LIBRARY_PATH/LD_PRELOAD overrides")
    endif()
    set(installed "${TOTP_STAGE_DIR}/plugins/TOTP.so")
    set(expected AmxLoad AmxUnload ComponentEntryPoint Load Supports Unload)
    if(ARGC GREATER 4 AND ARGV4 STREQUAL "component")
        set(installed "${TOTP_STAGE_DIR}/components/TOTP.so")
    endif()
    package_run(exports nm -D --defined-only "${installed}")
    foreach(name IN LISTS expected)
        if(NOT exports MATCHES "[ \t]${name}(\r?\n|$)")
            message(FATAL_ERROR "Missing hybrid runtime export: ${name}")
        endif()
    endforeach()
    package_check_ldd("${plugin}" "${crypto}" original)
    package_run(dynamic readelf -d "${installed}")
    string(REGEX MATCHALL "\\((RUNPATH|RPATH)\\)[^\n]+" paths "${dynamic}")
    list(LENGTH paths path_count)
    if(NOT path_count EQUAL 1 OR NOT paths MATCHES "\\[\\$ORIGIN/[.][.]\\]")
        message(FATAL_ERROR "Installed plugin must use only $ORIGIN/.. for runtime lookup")
    endif()
    package_check_ldd("${installed}" "${TOTP_STAGE_DIR}/libcrypto.so.3" resolved)
    package_run(versions readelf --version-info "${installed}" "${crypto}")
    string(REGEX MATCHALL "GLIBC_[0-9]+[.][0-9]+([.][0-9]+)?" versions "${versions}")
    if(NOT versions)
        message(FATAL_ERROR "Could not determine required GLIBC symbol versions")
    endif()
    list(SORT versions COMPARE NATURAL)
    list(GET versions -1 glibc)
    string(REPLACE "GLIBC_" "" glibc "${glibc}")
    set(runtime "{}")
    foreach(pair "build_ldd;original" "installed_ldd;resolved" "dynamic_section;dynamic" "highest_required_glibc;glibc")
        list(GET pair 0 key)
        list(GET pair 1 variable)
        package_json_quote(value "${${variable}}")
        string(JSON runtime SET "${runtime}" "${key}" "${value}")
    endforeach()
    set(${output} "${runtime}" PARENT_SCOPE)
    set(${glibc_output} "${glibc}" PARENT_SCOPE)
endfunction()
