cmake_minimum_required(VERSION 3.25)

include("${CMAKE_CURRENT_LIST_DIR}/PackageChecks.cmake")
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED TOTP_BUILD_DIR OR TOTP_BUILD_DIR STREQUAL "")
    message(FATAL_ERROR "Specify -DTOTP_BUILD_DIR=<Release build tree>")
endif()
get_filename_component(TOTP_BUILD_DIR "${TOTP_BUILD_DIR}" ABSOLUTE)
load_cache("${TOTP_BUILD_DIR}" READ_WITH_PREFIX cache_
    CMAKE_BUILD_TYPE CMAKE_HOME_DIRECTORY VCPKG_INSTALLED_DIR VCPKG_TARGET_TRIPLET)
file(REAL_PATH "${cache_CMAKE_HOME_DIRECTORY}" source_root)
if(NOT source_root STREQUAL root OR NOT cache_CMAKE_BUILD_TYPE STREQUAL "Release")
    message(FATAL_ERROR "Package this source tree's Release build only")
endif()
if(CMAKE_HOST_WIN32)
    set(TOTP_PLATFORM windows)
    set(extension dll)
    set(crypto_relative bin/libcrypto-3.dll)
    set(architecture PE32/i386)
    set(triplet x86-windows)
    if(NOT IS_DIRECTORY "${TOTP_MSVC_RUNTIME_DIR}")
        message(FATAL_ERROR "Specify -DTOTP_MSVC_RUNTIME_DIR=<compiler's x86 CRT redist>")
    endif()
elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    set(TOTP_PLATFORM linux)
    set(extension so)
    set(crypto_relative lib/libcrypto.so.3)
    set(architecture ELF32/i386)
    set(triplet x86-linux-shared)
else()
    message(FATAL_ERROR "Package on Windows or Linux, matching the target OS")
endif()
if(NOT cache_VCPKG_TARGET_TRIPLET STREQUAL triplet AND
   NOT cache_VCPKG_TARGET_TRIPLET STREQUAL "${triplet}-release")
    message(FATAL_ERROR "Expected ${triplet} or ${triplet}-release, got ${cache_VCPKG_TARGET_TRIPLET}")
endif()
set(dependency "${cache_VCPKG_INSTALLED_DIR}/${cache_VCPKG_TARGET_TRIPLET}")
foreach(kind STAGE OUTPUT)
    if(NOT DEFINED TOTP_${kind}_DIR)
        if(kind STREQUAL "STAGE")
            set(TOTP_STAGE_DIR "${root}/build/package-stage/${TOTP_PLATFORM}-x86")
        else()
            set(TOTP_OUTPUT_DIR "${root}/build/packages")
        endif()
    endif()
    get_filename_component(TOTP_${kind}_DIR "${TOTP_${kind}_DIR}" ABSOLUTE)
endforeach()
set(archive "${TOTP_OUTPUT_DIR}/TOTP-${TOTP_PLATFORM}-x86.zip")
set(verify "${TOTP_STAGE_DIR}-verify")
set(metadata "${TOTP_STAGE_DIR}-metadata")
foreach(directory "${TOTP_STAGE_DIR}" "${verify}" "${metadata}")
    file(GLOB contents "${directory}/*" "${directory}/.*")
    if(contents)
        message(FATAL_ERROR "Use an empty staging/verification directory: ${directory}")
    endif()
endforeach()
if(EXISTS "${archive}")
    message(FATAL_ERROR "Refusing to overwrite existing archive: ${archive}")
endif()

set(plugin "${TOTP_BUILD_DIR}/TOTP.${extension}")
set(crypto "${dependency}/${crypto_relative}")
get_filename_component(crypto_name "${crypto}" NAME)
package_check_architecture("${plugin}")
package_check_architecture("${crypto}")
if(TOTP_PLATFORM STREQUAL "windows")
    file(SHA256 "${TOTP_BUILD_DIR}/${crypto_name}" deployed_hash)
    file(SHA256 "${crypto}" selected_hash)
    if(NOT deployed_hash STREQUAL selected_hash)
        message(FATAL_ERROR "Selected crypto differs from the build's deployed DLL")
    endif()
endif()
package_run(install_log "${CMAKE_COMMAND}" --install "${TOTP_BUILD_DIR}"
    --config Release --prefix "${TOTP_STAGE_DIR}")
message(STATUS "${install_log}")
set(installed "${TOTP_STAGE_DIR}/plugins/TOTP.${extension}")
package_check_architecture("${installed}")
file(COPY_FILE "${crypto}" "${TOTP_STAGE_DIR}/${crypto_name}")
file(MAKE_DIRECTORY "${metadata}/licenses")
foreach(name LICENSE README.md)
    file(RENAME "${TOTP_STAGE_DIR}/${name}" "${metadata}/${name}")
endforeach()
file(COPY_FILE "${dependency}/share/openssl/copyright" "${metadata}/licenses/OpenSSL.txt")
if(TOTP_PLATFORM STREQUAL "windows")
    package_windows_runtime("${installed}" runtime)
else()
    package_linux_runtime("${plugin}" "${crypto}" runtime glibc)
endif()
set(files "plugins/TOTP.${extension}" qawno/include/totp.inc pawno/include/totp.inc "${crypto_name}")
list(SORT files)
foreach(name IN LISTS files)
    if(NOT EXISTS "${TOTP_STAGE_DIR}/${name}")
        message(FATAL_ERROR "Required package file missing: ${name}")
    endif()
endforeach()
file(SHA256 "${TOTP_STAGE_DIR}/qawno/include/totp.inc" qawno_hash)
file(SHA256 "${TOTP_STAGE_DIR}/pawno/include/totp.inc" pawno_hash)
if(NOT qawno_hash STREQUAL pawno_hash)
    message(FATAL_ERROR "Editor include copies differ")
endif()
configure_file("${CMAKE_CURRENT_LIST_DIR}/PackageInstall-${TOTP_PLATFORM}.md.in"
    "${metadata}/INSTALL.md" @ONLY)
file(STRINGS "${root}/src/main.h" version_line REGEX "^#define[ \t]+TOTP_PLUGIN_VER[ \t]+\"")
if(NOT version_line MATCHES "TOTP_PLUGIN_VER[ \t]+\"([^\"]+)\"")
    message(FATAL_ERROR "Plugin version definition missing")
endif()
set(version "${CMAKE_MATCH_1}")
if(NOT DEFINED TOTP_REVISION)
    set(TOTP_REVISION "unknown-local-working-tree")
endif()
set(manifest "{}")
set(classification "development artifact; not a production release")
set(configuration Release)
set(openssl 3.5.9)
foreach(pair "classification;classification" "version;version" "platform;TOTP_PLATFORM"
        "architecture;architecture" "configuration;configuration" "revision;TOTP_REVISION" "openssl;openssl")
    list(GET pair 0 key)
    list(GET pair 1 variable)
    package_json_quote(value "${${variable}}")
    string(JSON manifest SET "${manifest}" "${key}" "${value}")
endforeach()
string(JSON manifest SET "${manifest}" runtime "${runtime}")
file(WRITE "${metadata}/BUILD-INFO.json" "${manifest}\n")
file(GLOB_RECURSE staged LIST_DIRECTORIES FALSE RELATIVE "${TOTP_STAGE_DIR}" "${TOTP_STAGE_DIR}/*")
list(SORT staged)
if(NOT staged STREQUAL files)
    message(FATAL_ERROR "Staging must contain only the plugin, editor includes and libcrypto: ${staged}")
endif()
set(checksums "")
foreach(name IN LISTS files)
    file(SHA256 "${TOTP_STAGE_DIR}/${name}" hash)
    string(APPEND checksums "${hash}  ${name}\n")
    if(name MATCHES "[.]so($|[.])")
        file(CHMOD "${TOTP_STAGE_DIR}/${name}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE
            GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    else()
        file(CHMOD "${TOTP_STAGE_DIR}/${name}" PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ)
    endif()
endforeach()
file(WRITE "${metadata}/SHA256SUMS" "${checksums}")
file(MAKE_DIRECTORY "${TOTP_OUTPUT_DIR}")
# cmake -E tar provides a working directory on CMake 3.25, and preserves ZIP paths/modes.
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${archive}" --format=zip
    "--mtime=1980-01-01 00:00:00 UTC" -- ${files}
    WORKING_DIRECTORY "${TOTP_STAGE_DIR}" COMMAND_ERROR_IS_FATAL ANY)
file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${verify}")
file(GLOB_RECURSE extracted LIST_DIRECTORIES FALSE RELATIVE "${verify}" "${verify}/*")
list(SORT extracted)
if(NOT extracted STREQUAL files)
    message(FATAL_ERROR "ZIP inventory differs from staged files")
endif()
foreach(name IN LISTS files)
    file(SHA256 "${TOTP_STAGE_DIR}/${name}" expected)
    file(SHA256 "${verify}/${name}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "ZIP content mismatch: ${name}")
    endif()
endforeach()
file(SHA256 "${archive}" hash)
file(WRITE "${archive}.sha256" "${hash}  TOTP-${TOTP_PLATFORM}-x86.zip\n")
message(STATUS "Created ${archive}; SHA256 ${hash}")
foreach(name IN LISTS files)
    message(STATUS "  ${name}")
endforeach()
